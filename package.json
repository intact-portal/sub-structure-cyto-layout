{
  "name": "@intact-ebi/cytoscape-lumina",
  "version": "1.0.1",
  "description": "LUMINA: a structure-aware Cytoscape.js layout that detects cycles, chains, stars and parallel groups and lays them out with force-directed or stress-majorization solvers.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lumina-layout.js",
    "dist/lumina-layout.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:browser && cp demo/favicon.ico dist/favicon.ico && cp demo/index.html dist/index.html && cp node_modules/cytoscape/dist/cytoscape.min.js dist/ && if [ -d demo/data ]; then cp -r demo/data dist/data; fi && touch dist/.nojekyll",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --external:cytoscape --outfile=dist/lumina-browser.js",
    "dev": "npm run build && concurrently \"tsc --watch\" \"npm run build:browser -- --watch\" \"node watch.cjs\" \"http-server dist -p 8080 -c-1\"",
    "deploy": "./deploy.sh",
    "build:lib": "tsc",
    "local-publish": "npm run build:lib && yalc push",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build:lib"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cytoscape": "^3.33.1",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "keywords": [
    "cytoscape",
    "cytoscape-extension",
    "layout",
    "graph",
    "network",
    "lumina"
  ],
  "author": "Shutan Xu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intact-portal/sub-structure-cyto-layout.git"
  },
  "homepage": "https://github.com/intact-portal/sub-structure-cyto-layout#readme",
  "bugs": {
    "url": "https://github.com/intact-portal/sub-structure-cyto-layout/issues"
  },
  "peerDependencies": {
    "cytoscape": "^3.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "fastpriorityqueue": "^0.8.0"
  }
}
